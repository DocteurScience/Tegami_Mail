msgid_plural "Filters filed {filed} of {n} messages away"
msgstr[0] "Τα φίλτρα αρχειοθέτησαν {filed} από {n} μήνυμα"
msgstr[1] "Τα φίλτρα αρχειοθέτησαν {filed} από {n} μηνύματα"

