msgid_plural "deleted {n} messages"
msgstr[0] "διέγραψε {n} μήνυμα"
msgstr[1] "διέγραψε {n} μηνύματα"

msgid "Filters looked at {n} message, and it matched nothing"
msgid_plural "Filters looked at {n} messages, and none of them matched"
msgstr[0] "Τα φίλτρα εξέτασαν {n} μήνυμα και δεν αντιστοιχίστηκε σε τίποτα"
msgstr[1] "Τα φίλτρα εξέτασαν {n} μηνύματα και κανένα δεν αντιστοιχίστηκε"

#. Matches that needed nothing: the rules had already done their
#. work on an earlier sync (#201). Saying "none matched" here
#. made working rules look broken.
msgid "Filters looked at {n} message"
msgid_plural "Filters looked at {n} messages"
msgstr[0] "Τα φίλτρα εξέτασαν {n} μήνυμα"
msgstr[1] "Τα φίλτρα εξέτασαν {n} μηνύματα"

msgid ""
"Filters matched {matched} of {n} message, and it was already tagged or filed"
msgid_plural ""
"Filters matched {matched} of {n} messages, and all of them were already "
"tagged or filed"
msgstr[0] ""
"Τα φίλτρα αντιστοίχισαν {matched} από {n} μήνυμα και είχε ήδη ετικέτα ή "
"αρχειοθετηθεί"
msgstr[1] ""
"Τα φίλτρα αντιστοίχισαν {matched} από {n} μηνύματα και όλα είχαν ήδη ετικέτα "
