msgid "Empty"
msgstr "Άδειασμα"

msgid "Create folder"
msgstr "Δημιουργία φακέλου"

msgid "archive"
msgstr "αρχειοθέτηση"

msgid "trash"
msgstr "κάδος"

msgid "destination"
msgstr "προορισμός"

msgid "Move folder"
msgstr "Μετακίνηση φακέλου"

msgid "Always do this (change it in Settings → System → GNOME Files)"
msgstr "Να γίνεται πάντα αυτό (αλλαγή στις Ρυθμίσεις → Σύστημα → Αρχεία GNOME)"

msgid "Could not attach {names}: Tegami Mail cannot read the file."
msgid_plural ""
"Could not attach {n} files (Tegami Mail cannot read them): {names}"
msgstr[0] ""
"Δεν ήταν δυνατή η επισύναψη των {names}: το Tegami Mail δεν μπορεί να "
"διαβάσει το αρχείο."
msgstr[1] ""
"Δεν ήταν δυνατή η επισύναψη {n} αρχείων (το Tegami Mail δεν μπορεί να τα "
"διαβάσει): {names}"

msgid "Send {n} file with Tegami Mail"
msgid_plural "Send {n} files with Tegami Mail"
msgstr[0] "Αποστολή {n} αρχείου με το Tegami Mail"
msgstr[1] "Αποστολή {n} αρχείων με το Tegami Mail"

msgid "{names} ({size}). What should the files go into?"
msgstr "{names} ({size}). Σε τι θέλετε να προστεθούν τα αρχεία;"

msgid "Reply to a message…"
msgstr "Απάντηση σε μήνυμα…"

msgid "Continue a draft…"
msgstr "Συνέχιση προχείρου…"

msgid "Reply to a message"
msgstr "Απάντηση σε μήνυμα"

msgid "The files go into a reply to the message you pick."
msgstr "Τα αρχεία θα προστεθούν σε απάντηση προς το μήνυμα που θα επιλέξετε."

