msgid_plural "Looked at {n} messages so far"
msgstr[0] "Εξετάστηκε {n} μήνυμα μέχρι στιγμής"
msgstr[1] "Εξετάστηκαν {n} μηνύματα μέχρι στιγμής"

msgid "Matched {n} message"
msgid_plural "Matched {n} messages"
msgstr[0] "Αντιστοιχίστηκε {n} μήνυμα"
msgstr[1] "Αντιστοιχίστηκαν {n} μηνύματα"

