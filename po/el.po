msgstr "Δεν υπάρχουν ακόμη μηνύματα για απάντηση."

msgid "Reply with the files"
msgstr "Απάντηση με τα αρχεία"

msgid "Large files"
msgstr "Μεγάλα αρχεία"

msgid ""
"{names} is {size}, over the {limit} limit. Upload it to cloud storage and "
"put a download link in the message instead?"
msgid_plural ""
"{names} add up to {size}, over the {limit} limit. Upload them to cloud "
"storage and put download links in the message instead?"
msgstr[0] ""
"Το {names} έχει μέγεθος {size}, πάνω από το όριο των {limit}. Να "
"μεταφορτωθεί σε αποθήκευση cloud και να προστεθεί σύνδεσμος λήψης στο μήνυμα;"
msgstr[1] ""
"Τα {names} έχουν συνολικό μέγεθος {size}, πάνω από το όριο των {limit}. Να "
"μεταφορτωθούν σε αποθήκευση cloud και να προστεθούν σύνδεσμοι λήψης στο "
"μήνυμα;"

msgid "Attach anyway"
msgstr "Επισύναψη ούτως ή άλλως"

msgid "Upload to cloud storage"
msgstr "Μεταφόρτωση σε αποθήκευση cloud"

msgid "This message carries no calendar file to open."
