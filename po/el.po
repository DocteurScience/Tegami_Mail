msgid_plural "Filters tagged {tagged} of {n} messages"
msgstr[0] "Τα φίλτρα πρόσθεσαν ετικέτα σε {tagged} από {n} μήνυμα"
msgstr[1] "Τα φίλτρα πρόσθεσαν ετικέτες σε {tagged} από {n} μηνύματα"

