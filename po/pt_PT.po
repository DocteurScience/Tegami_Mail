msgstr "Eliminar assinatura"

msgid "With several signatures, the composer offers a button to choose."
msgstr "Com várias assinaturas, o editor oferece um botão para escolher."

msgid "Add signature"
msgstr "Adicionar assinatura"

#. A designed signature usually exists as HTML already (#120).
msgid "Import file…"
msgstr "Importar ficheiro…"

msgid "HTML or text"
msgstr "HTML ou texto"

msgid "Automatic: the key whose address matches."
msgstr "Automático: a chave cujo endereço corresponde."

