msgstr "Não está disponível nenhum livro de endereços para adicionar contactos"

msgid "Email"
msgstr "E-mail"

msgid "Added to contacts"
msgstr "Adicionado aos contactos"

msgid "Added email to {name}"
msgstr "E-mail adicionado a {name}"

msgid "Already in contacts ({name})"
msgstr "Já existe nos contactos ({name})"

msgid "Could not add contact: {e}"
msgstr "Não foi possível adicionar o contacto: {e}"

msgid "Search filters"
msgstr "Pesquisar filtros"

