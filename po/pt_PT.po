msgid "Look through every mailbox for tags other clients have set"
msgstr ""
"Procurar em todas as caixas de correio etiquetas definidas por outros "
"clientes"

msgid "Senders"
msgstr "Remetentes"

msgid "Translation"
msgstr "Tradução"

msgid "Backup and restore"
msgstr "Cópia de segurança e restauro"

msgid "Drag an account to change its order in the sidebar."
msgstr "Arraste uma conta para alterar a sua ordem na barra lateral."

msgid "Organize mail"
msgstr "Organizar correio"

msgid "Services"
msgstr "Serviços"

msgid "Allowed and blocked"
msgstr "Permitidos e bloqueados"

msgid "Composing"
msgstr "Composição"

