msgstr ""
"Eliminou um anexo desta mensagem. Os cabeçalhos MIME originais do anexo eram:"

msgid "no network connection"
msgstr "sem ligação à rede"

msgid "runtime error: {e}"
msgstr "erro de execução: {e}"

