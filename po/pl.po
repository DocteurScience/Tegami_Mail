msgstr ""
"Nie można połączyć się z {server} przez TLS. Sprawdź serwer, port i czy "
"obsługuje LDAPS."

msgid "Could not connect to {server}. Check the server and the port."
msgstr "Nie można połączyć się z {server}. Sprawdź serwer i port."

msgid ""
"Could not start StartTLS with {server}: the server does not offer it, or its "
"certificate is not trusted."
msgstr ""
"Nie można uruchomić StartTLS z {server}: serwer go nie oferuje lub jego "
"certyfikat nie jest zaufany."

msgid "Could not reach {server}. Check the server's name and the network."
msgstr "Nie można połączyć się z {server}. Sprawdź nazwę serwera i sieć."

msgid "The directory needs a password. Add it in Settings → Contacts."
msgstr "Katalog wymaga hasła. Dodaj je w Ustawieniach → Kontakty."

